<?xml version="1.0"?>

<robot name="cylinder">

  <!-- Define a cylinder link -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="1.0" radius="0.5"/>
      </geometry>
    </visual>
    <collision>
      <geometry>
        <cylinder length="1.0" radius="0.5"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.0"/>
      <origin rpy="0 0 0" xyz="0 0 0.5"/>
      <inertia ixx="0.083333" ixy="0.0" ixz="0.0" iyy="0.083333" iyz="0.0" izz="0.166667"/>
    </inertial>
  </link>

</robot>
